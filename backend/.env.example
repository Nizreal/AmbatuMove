APP_ENV=development
HTTP_ADDR=:8080
DATABASE_PATH=./data/ambatumove.sqlite
PUBLIC_BASE_URL=
JWT_SIGNING_KEY=
JWT_ISSUER=ambatumove
JWT_AUDIENCE=ambatumove-mobile
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info
PLANNER_MAX_GENERATION_MS=1500
PUBLIC_RATE_LIMIT_RPM=60
PARTNER_RATE_LIMIT_RPM=120
TRUSTED_PROXY_CIDRS=
REFERENCE_CACHE_ENABLED=true
GYM_CACHE_ENABLED=true
SEED_SYNTHETIC_GYMS=false
AI_ENABLED=false
AI_PROVIDER=gemini
# Add the real key only to an untracked, permission-restricted environment file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=512
AI_RATE_LIMIT_RPM=5
AI_MAX_CONCURRENT_REQUESTS=1
