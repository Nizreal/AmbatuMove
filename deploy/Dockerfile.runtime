FROM alpine:3.22
RUN apk --no-cache add ca-certificates tzdata \
    && addgroup -S -g 10001 app \
    && adduser -S -D -H -u 10001 -G app app \
    && mkdir -p /app /data \
    && chown -R 10001:10001 /app /data
COPY server /app/server
USER 10001:10001
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["/app/server"]
CMD ["serve"]
