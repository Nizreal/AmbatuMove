# Install as $AMBATUMOVE_INSTALL_ROOT/config/ambatumove.env on the STB and chmod 600.
DATA_HOST_DIR=/mnt/storage/ambatumove
GATEWAY_PORT=18080
AMBATUMOVE_IMAGE=ambatumove-core:unset
APP_ENV=production
JWT_SIGNING_KEY=REPLACE_WITH_BASE64_ENCODED_RANDOM_KEY_AT_LEAST_32_BYTES
JWT_ISSUER=ambatumove
JWT_AUDIENCE=ambatumove-mobile
PUBLIC_BASE_URL=https://your-hostname.example
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info
PLANNER_MAX_GENERATION_MS=1500
PUBLIC_RATE_LIMIT_RPM=60
PARTNER_RATE_LIMIT_RPM=120
REFERENCE_CACHE_ENABLED=true
GYM_CACHE_ENABLED=true
SEED_SYNTHETIC_GYMS=false
TRUSTED_PROXY_CIDRS=172.29.240.10/32
